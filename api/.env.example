# Copy this file to .env in the api directory. Never commit the populated .env.

# Amazon Bedrock
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# Preferred for local development: paste one Amazon Bedrock API key here.
AWS_BEARER_TOKEN_BEDROCK=

# Alternative: use a standard AWS access-key pair instead of the bearer token.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

BEDROCK_CONNECT_TIMEOUT=10
BEDROCK_READ_TIMEOUT=120
BEDROCK_MAX_ATTEMPTS=3
BEDROCK_MAX_CONCURRENCY=8
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
BEDROCK_TOP_P=1
BEDROCK_STREAMING=true

# GraphDB
GRAPHDB_ENDPOINT=http://localhost:7200/repositories/sakunagraph
